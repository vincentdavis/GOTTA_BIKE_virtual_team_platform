# =============================================================================
# Local development environment — copy to `.env` and edit.
#
#     cp -n .env.example.local .env      # -n: never clobber an existing .env
#
# Every variable here has a working default in gotta_bike_platform/config.py —
# not one field is required — so the app BOOTS with an empty .env. What you set
# decides which FEATURES work, not whether it starts.
#
# NOT EVERYTHING LIVES HERE. Runtime settings — the Discord bot token, guild ID,
# role→permission mappings, API credentials for ZwiftPower/ZwiftRacing/Strava —
# are django-constance settings stored in the DATABASE and edited at
# /site/config/ or /admin/constance/config/. Do not go looking for them as env
# vars; `from constance import config` and this file are unrelated objects, a
# distinction that has caught people out before.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED TO RUN LOCALLY
#
# Strictly: nothing. Defaults give you SQLite and an insecure signing key, which
# is what you want locally. But set these two — the defaults are production
# defaults and make local dev worse.
# -----------------------------------------------------------------------------

# Turns on the Django debug toolbar and browser auto-reload, and shows real
# tracebacks instead of a 500 page. Defaults to False.
DEBUG=True

# Any non-empty string is fine locally. The default is a literal placeholder
# ("django-insecure-change-me-in-production"); it works, but sessions do not
# survive changing it, so pick something and leave it alone.
SECRET_KEY=local-dev-not-a-secret


# -----------------------------------------------------------------------------
# 2. GETTING SIGNED IN
#
# Discord OAuth is the ONLY way to log in as a normal user — there is no
# username/password form. Two options locally:
#
#   (a) Skip it. Run `uv run python manage.py createsuperuser` and use
#       /admin/. A superuser bypasses every permission check, so most of the
#       app is reachable this way. Simplest, and enough for most work.
#
#   (b) Real Discord login. Create a Discord application, add a redirect of
#       http://127.0.0.1:8000/accounts/discord/login/callback/ and set the two
#       values below. Note sign-in ALSO requires guild membership: the adapter
#       rejects anyone who is not in the server named by the GUILD_ID constance
#       setting, so you must set that (in the DB, not here) to a guild you are
#       actually in, or you will be bounced on every attempt.
# -----------------------------------------------------------------------------

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 3. DATABASE
#
# Defaults to SQLite at ./db.sqlite3, which is the normal local setup.
# Production is PostgreSQL on Railway — point at Postgres only if you are
# specifically chasing a Postgres-versus-SQLite difference (there are real ones;
# see the migration notes in CLAUDE.md).
# -----------------------------------------------------------------------------

# DATABASE_URL=postgres://user:pass@localhost:5432/gotta_bike

# Seconds Django holds a connection open for reuse. Keep the default locally;
# it is tuned in production against Railway's connection ceiling.
# DB_CONN_MAX_AGE=60


# -----------------------------------------------------------------------------
# 4. OPTIONAL — ZWIFT DATA AND VERIFICATION (the "zauth" service)
#
# Enables: Zwift account verification via OAuth, the consolidated Racing &
# Performance card on profiles, and the rider-profile sync.
#
# Without these: the verification flow cannot connect a Zwift account, the
# profile card shows "not synced", and sync_rider_profiles logs a warning and
# no-ops. Nothing crashes.
#
# These point at the separate GOTTA_BIKE_zwift_api service. In production it is
# reached over Railway's private network; locally you need that service running
# and its URL here.
# -----------------------------------------------------------------------------

# ZWIFT_API_BASE_URL=http://localhost:8001
# ZWIFT_APP_API_KEY=            # per-app key: OAuth + connection status endpoints
# ZWIFT_SERVICE_API_KEY=        # service key: the zwid-keyed batch profile endpoints
# ZWIFT_CONNECTED_APP_NAME=     # this platform's app name there, for connected-rider batches


# -----------------------------------------------------------------------------
# 5. OPTIONAL — FILE UPLOADS (S3)
#
# Enables: verification photos/videos stored in object storage.
#
# Without these: media is written to the local filesystem under ./media/, which
# is what you want locally. Set them only to reproduce a storage-specific bug.
# Static files are served by WhiteNoise either way and need nothing here.
# -----------------------------------------------------------------------------

# AWS_S3_ENDPOINT_URL=https://storage.railway.app
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=auto


# -----------------------------------------------------------------------------
# 6. OPTIONAL — GOOGLE SHEETS EXPORT
#
# Enables: the /data-connections/ Sheets exports.
# Without it: creating or syncing a data connection fails; nothing else notices.
#
# A service-account JSON key, base64-encoded:
#     base64 -i service-account.json | tr -d '\n'
# -----------------------------------------------------------------------------

# GOOGLE_CREDENTIALS_BASE64=


# -----------------------------------------------------------------------------
# 7. OPTIONAL — TTT OPTIMIZER
#
# Enables: the optimize endpoint in the TTT planner (zwiftgopher.com).
# Without it: the rest of the planner works; optimize does not.
# -----------------------------------------------------------------------------

# ZWIFT_GOPHER_API=


# -----------------------------------------------------------------------------
# 8. OPTIONAL — OBSERVABILITY
#
# Without a token Logfire runs in local mode: `logfire.info(...)` calls still
# execute and print to the console, they just are not shipped anywhere. Leave it
# unset locally.
#
# Worth knowing: without a token some failure logs are the only record of, say,
# which rider did not receive a DM.
# -----------------------------------------------------------------------------

# LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development


# -----------------------------------------------------------------------------
# 9. NOT NEEDED LOCALLY — deploy-time only
#
# SUPERUSER_* are read by `manage.py ensuresuperuser`, an idempotent bootstrap
# for a fresh Railway deploy. Locally use `createsuperuser` instead.
#
# ALLOWED_HOSTS_STR / CORS_ALLOWED_ORIGINS_STR / HSTS_SECONDS have local-safe
# defaults (localhost, no CORS, HSTS only applied when DEBUG is off).
#
# RAILWAY_PRIVATE_DOMAIN, RAILWAY_GIT_COMMIT_SHA, DEPLOY_VERSION and
# DEPLOY_TIMESTAMP are injected by Railway and read directly from the
# environment. They are absent locally, which is correct.
# -----------------------------------------------------------------------------

# SUPERUSER_USERNAME=
# SUPERUSER_EMAIL=
# SUPERUSER_PASSWORD=
# ALLOWED_HOSTS_STR=localhost,127.0.0.1
# INTERNAL_IPS_STR=127.0.0.1
# CORS_ALLOWED_ORIGINS_STR=
# HSTS_SECONDS=31536000


# -----------------------------------------------------------------------------
# BACKGROUND WORK — no env vars, but easy to miss
#
# Scheduled jobs need TWO processes besides runserver, in separate terminals:
#
#     uv run python manage.py scheduler    # enqueues jobs on their interval
#     uv run python manage.py db_worker    # executes what the scheduler queued
#
# Neither is needed to browse the site. Without the worker, anything enqueued
# (including "Run Now" from /site/config/background_tasks/) sits unexecuted.
# -----------------------------------------------------------------------------
